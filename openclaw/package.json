{
  "name": "openclaw-lutron",
  "version": "0.1.10",
  "description": "OpenClaw plugin for Lutron Caseta smart lighting control (scenes, Smart Away, devices, areas)",
  "type": "module",
  "openclaw": {
    "extensions": [
      "./src/index.ts"
    ],
    "compat": {
      "pluginApi": ">=2026.6.5"
    },
    "build": {
      "openclawVersion": "2026.6.5",
      "pluginSdkVersion": "2026.6.5"
    },
    "environment": {
      "binaries": [
        "lutron"
      ]
    }
  },
  "files": [
    "dist/",
    "src/",
    "skills/",
    "openclaw.plugin.json"
  ],
  "main": "./dist/index.js",
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.json",
    "prepack": "npm run build"
  },
  "keywords": [
    "openclaw",
    "openclaw-plugin",
    "lutron",
    "caseta",
    "smart-home",
    "home-automation",
    "lighting"
  ],
  "author": {
    "name": "Omar Shahine",
    "email": "omar@shahine.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/omarshahine/lutron-cli.git",
    "directory": "openclaw"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "openclaw": "^2026.6.5"
  }
}
